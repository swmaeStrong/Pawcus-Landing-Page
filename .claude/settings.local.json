      "Bash(curl:*)",
      "Bash(pkill:*)",
      "Bash(npm start)",
      "Bash(rm:*)",
      "Bash(npm run build:*)",
      "Bash(rg:*)",
      "Bash(grep:*)",
      "WebFetch(domain:screen.studio)",
      "Bash(git checkout:*)",
      "Bash(npm install:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(git restore:*)",
      "Bash(cp:*)",
      "Bash(lsof:*)",
